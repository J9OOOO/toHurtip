import "math"

function indexOf(array, arg) {
    create i = 0
    while(i < array.length) {
        if (array[i] == arg) {return i}
        i = i + 1
    }
    return -1
}

function lastIndexOf(array, arg) {
    create i = array.length - 1
    while(i >= 0) {
        if (array[i] == arg) {return i}
        i = i - 1
    }
    return -1
}

function includes(array, arg) {
    create i = 0
    while(i < array.length) {
        if (array[i] == arg) {return true}
        i = i + 1
    }
    return false
}

function addArray(array, arg) {
    create i = 0
    while(i < array.length) {
        array[i] = array[i] + arg
        i = i + 1
    }
    return array
}

function subArray(array, arg) {
    create i = 0
    while(i < array.length) {
        array[i] = array[i] - arg
        i = i + 1
    }
    return array
}

function mulArray(array, arg) {
    create i = 0
    while(i < array.length) {
        array[i] = array[i] * arg
        i = i + 1
    }
    return array
}

function divArray(array, arg) {
    create i = 0
    while(i < array.length) {
        array[i] = array[i] / arg
        i = i + 1
    }
    return array
}

function slice(array, inicio, fim) {
    create i = inicio
    create arrayNovo = []
    while (i <= fim) {
        arrayNovo[arrayNovo.length] = (array[i])
        i = i + 1
    }
    return arrayNovo
}

function sliceReverse(array, inicio, fim) {
    create i = 0
    create arrayNovo = []
    while (i < array.length) {
        if (i < inicio or i > fim) {arrayNovo[arrayNovo.length] = (array[i])}
        i = i + 1
    }
    return arrayNovo
}

function sum(array) {
    create i = 0
    create s = 0
    while(i < array.length) {
        s = s + array[i]
        i = i + 1
    }
    return s
}

function median(array) {
    return sum(array) / array.length
}

function dam(array) {
    create s = 0
    create i = 0
    create med = median(array)
    while(i < array.length) {
        s = s + math.abs(med - array[i])
        i = i + 1
    }
    return s / array.length
}

function var(array) {
    create s = 0
    create i = 0
    create med = median(array)
    while(i < array.length) {
        s = s + math.pow(math.abs(med - array[i]), 2)
        i = i + 1
    }
    return s / array.length
}

function reverse(array) {
    create i = 0
    create arrayNovo = []
    while(i < array.length) {
        arrayNovo[i] = array[array.length - i - 1]
        i = i + 1
    }
    return arrayNovo
}

function push(array, arg) {
    create i = 0
    create arrayNovo = []
    while(i < array.length) {
        arrayNovo[i] = array[i]
        i = i + 1
    }
    arrayNovo[array.length] = arg
    return arrayNovo
}

function pop(array) {
    create i = 0
    create arrayNovo = []
    while(i < array.length - 1) {
        arrayNovo[i] = array[i]
        i = i + 1
    }
    return arrayNovo
}

function pushMut(array, arg) {
    array[array.length] = arg
}

function dup(array, arg) {
    if (indexOf(array, arg) != lastIndexOf(array, arg)) {return true}
    return false
}

function someDup(array) {
    create i = 0
    create j = 0

    while(i < array.length) {
        j = i + 1

        while(j < array.length) {
            if (array[i] == array[j]) {return true}
            j = j + 1
        }

        i = i + 1
    }

    return false
}

function nada() {
    create i = 0
    while(i < array.length) {

        i = i + 1
    }
}

