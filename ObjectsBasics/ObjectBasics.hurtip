load "Arrays.hurtip" as Array
load "Exception.hurtip" as Exp

function objectCreate(nomes, valores) {
    if (nomes.length != valores.length) {
        Exp.throwError(["As propriedades e os valores não tem tamanhos iguais", "Tamanho das propriedades: ", nomes.length, "", "Tamanho dos valores: ", valores.length], 0, "Objeto inválido")
    }
    if (Array.includes(nomes, "NotAProp")){
        Exp.throwError(["Por favor, remova essa propriedade ou troque de nome"], 0, "Há uma propriedade com o nome 'NotAProp'. Nome que é inválido")
    }
    if (Array.someDup(nomes)) {
        Exp.throwError(["Por favor, remova uma das propriedades ou altere o nome dela"], 0, "Há propriedades duplicados")
    }
    create i = 0
    create j = 0
    create Obj = []
    while(i < 2 * nomes.length) {
        Obj[i] = nomes[j]
        Obj[i + 1] = valores[j]
        i = i + 2
        j = j + 1
    }
    return Obj
}

function ObjC(nomes, valores) {
    return objectCreate(nomes, valores)
    //apenas uma forma de escrever mais veloz, sem destruir a compatibilidade
}

function val(obj, nome) {
    if (nome == "NotAProp") {
        Exp.excecaoSimples("Por favor, não tente encontrar o valor dessa propriedade", "Nome inválido para propriedade (NotAProp)")
    }
    create i = 0
    while(i < obj.length) {
        if (obj[i] == nome) {
            return obj[i + 1]
        }
        i = i + 2
    }
    Exp.throwError(["Propriedade inexistente: ", nome], 0, "Não há a propriedade escolhida")
}

function exists(obj, nome) {
    create i = 0
    while(i < obj.length) {
        if (obj[i] == nome) {return true}
        i = i + 2
    }
    return false
}

function mutVal(obj, nome, valor) {
    if (nome == "NotAProp") {
        Exp.excecaoSimples("Por favor, não tente alterar o valor dessa propriedade", "Nome inválido para propriedade (NotAProp)")
    }
    create lugar = posNome(obj, nome)
    if (lugar == -1) {
        Exp.throwError([nome], 0, "Propriedade inexistente: ")
    }
    obj[lugar + 1] = valor
}

function mutProp(obj, nome, nomeNovo) {
    verificar(nome)
    if (Array.includes(obj, nomeNovo)) {
        Exp.throwError(["Nome já existente: ", nome], 0, "Já existe algo com esse nome")
    }
    create lugar = posNome(obj, nome)
    if (lugar == -1) {
        Exp.throwError([nome], 0, "Propriedade inexistente: ")
    }
    obj[lugar] = nomeNovo
}

function posNome(obj, nome) {
    create i = 0
    while(i < obj.length) {
        if (obj[i] == nome) {return i}
        i = i + 2
    }
    return -1
}

function addProp(obj, nome, valor) {
    verificar(nome)
    if (Array.includes(obj, nome)) {
        Exp.throwError(["Nome já existente: ", nome], 0, "Já existe algo com esse nome")
    }
    create tamanho = obj.length
    obj[tamanho] = nome
    obj[tamanho + 1] = valor
}

function removeProp(obj, nome) {
    create lugar = posNome(obj, nome)
    if (lugar == -1) {
        Exp.throwError([nome], 0, "Propriedade inexistente: ")
    }
    obj[lugar] = "NotAProp"
}

function copy(obj) {
    create i = 0
    create objNovo = []
    while (i < obj.length) {
        if (obj[i] == "NotAProp") {i = i + 2}
        objNovo[i] = obj[i]
        i = i + 1
    }
    return objNovo
}

function verificar(a) {
    if (a == "NotAProp") {
        Exp.excecaoSimples("Por favor, não tente fazer algo com essa propriedade", "Nome inválido para propriedade (NotAProp)")
    }
}

function print(obj) {
    create i = 0
    view("{")
    while (i < obj.length) {
        if (obj[i] == "NotAProp") {i = i + 2}
        if (i < obj.length) {view("  ", obj[i], ":", obj[i + 1])}
        i = i + 2
    }
    view("}")
}

function instanceof(obj, obj2) {
    if (obj.length != obj2.length and not Array.includes(obj, "NotAProp") and not Array.includes(obj2, "NotAProp")) {return false}
    create i = 0
    while (i < obj.length) {
        if (i < obj2.length and not Array.includes(obj, obj2[i]) and obj2[i] != NotAProp) {return false}
        i = i + 2
    }
    return true
}

function PropExist(obj, prop) {
    create lugar = posNome(obj, nome)
    if (lugar == -1) {return false}
    return true
}

function strincInstanceOf(obj, obj2) {
    if (obj.length != obj2.length) {return false}
    create i = 0
    while (i < obj.length) {
        if (obj[i] != obj2[i]) {return false}
        i = i + 2
    }
    return true
}
