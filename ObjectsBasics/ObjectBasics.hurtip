        view("Nome inválido")
        explodir()
    }
}

function print(obj) {
    create i = 0
    view("{")
    while (i < obj.length) {
        if (obj[i] == "NotAProp") {i = i + 2}
        view(obj[i], ":", obj[i + 1])
        i = i + 2
    }
    view("}")
}

