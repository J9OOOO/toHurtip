load "Arrays.hurtip" as Array
load "Utils.hurtip" as Util

//Esses "loads" podem falhar se o sistema de carregamento for apenas na pasta em que está os arquivos, mas aí é só corrigir

function explodir() {
    return 1 / 0
}

function MatrixCreate(tamanho) {
    create i = 1
    create matrix = []

    while(i <= tamanho) {
        Array.pushMut(matrix, [])
        i = i + 1
    }

    i = 0
    create j = 0

    while(i < tamanho) {
        j = 0

        while(j < tamanho) {
            matrix[i][j] = 0
            j = j + 1
        }

        i = i + 1
    }

    return matrix
}

function MatrixDef(matrix, a) {
    create i = 0
    create j = 0
    create k = 0
    create tamanho = matrix.length

    while(i < tamanho) {
        j = 0

        while(j < tamanho) {
            matrix[i][j] = a[k]
            j = j + 1
            k = k + 1
        }

        i = i + 1
    }

    return matrix
}

function MatrixAdd(a, b) {
    if (a.length != b.length) {
        view("Matrizes de tamanho diferente")
        explodir()
    }
    create i = 0
    create j = 0

    create c = MatrixCreate(a.length)

    while(i < a.length) {
        j = 0

        while(j < a.length) {
            c[i][j] = a[i][j] + b[i][j]
            j = j + 1
        }

        i = i + 1
    }

    return c
}

function MatrixC(b) {
    if (not Util.isInteger(math.sqrt(b.length))) {
        view("Tamanho inválido")
        explodir()
    }
    create Matrix = MatrixCreate(math.sqrt(b.length))
    return MatrixDef(Matrix, b)
}
