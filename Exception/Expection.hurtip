function explodir() {
    return 1 / 0
}

function throwError(a, espaco, nomeDoErro) {
    view("  Exceção do tipo: ****", nomeDoErro, "****")
    if(a.length != 0) {
        view("  Mensagem de erro: ")
        view("  {")

        create i = 0
        while(i < a.length) {
            view("      ", a[i])

            if(espaco != 0) {
                create j = 0
                while(j < espaco) {
                    view()
                    j = j + 1
                }
            }
            i = i + 1
        }
        view("  }")
    } else {
        view("  {   Mensagem vazia  }")
    }
    explodir()
}

function excecaoSimples(mensagem, erro) {
    view("  Exceção do tipo: ****", erro, "****")
    view("  {")
    view("      ", mensagem)
    view("  }")
    explodir()
}

//throwError(["Limite: ", 100, "Obtido: ", 1000], 0, "erro de Array acima do limite")

throwError([], 0, "teste do erro")
